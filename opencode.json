{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "mysql": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "-y",
                "@benborla29/mcp-server-mysql"
            ],
            "environment": {
                "MYSQL_HOST": "{env:DB_HOST}",
                "MYSQL_PORT": "{env:DB_PORT}",
                "MYSQL_USER": "{env:DB_USERNAME}",
                "MYSQL_PASS": "{env:DB_PASSWORD}",
                "MYSQL_DB": "{env:DB_DATABASE}"
            }
        }
    }
}
